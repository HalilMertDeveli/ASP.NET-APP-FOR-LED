# ASP.NET user-secrets / ortam değişkenleri (GERÇEK DEĞER YAZMAYIN)

# Zorunlu — Supabase (sunucu tarafı service_role; tarayıcıya koymayın)
Supabase__Url=https://YOUR_PROJECT.supabase.co
Supabase__PublishableKey=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
Supabase__ServiceRoleKey=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Alternatif isimler:
# SUPABASE_URL=...
# SUPABASE_ANON_KEY=...
# SUPABASE_PUBLISHABLE_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...

# Zorunlu — Resend e-posta
Resend__ApiKey=YOUR_RESEND_API_KEY
# Alternatif: RESEND_API_KEY=...
Resend__FromEmail=LED Teknik Destek <onboarding@resend.dev>
Resend__ToEmail=halilmertdeveliii@gmail.com
# Alternatif: SUPPORT_EMAIL=halilmertdeveliii@gmail.com

# Opsiyonel — ingest RPC secret (kullanılıyorsa Vercel ile private.app_secrets senkron olmalı)
# Support__IngestSecret=YOUR_LONG_RANDOM_SECRET
# Alternatif: SUPPORT_INGEST_SECRET=...
# Not: PublishableKey + ingest RPC ile secret olmadan da kayıt çalışabilir.

Support__Mode=Direct
Support__RequireStore=true
