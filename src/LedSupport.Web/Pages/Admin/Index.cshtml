@page
@model LedSupport.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin";
    ViewData["Robots"] = "noindex, nofollow";
    ViewData["CanonicalPath"] = "/Admin";
}

<section class="page-hero page-hero-auth">
    <div class="container">
        <p class="eyebrow">Admin</p>
        <h1>Yönetim paneli</h1>
        <p class="page-lead">Müşteriler, talepler ve canlı destek mesajları.</p>
        <partial name="_AdminNav" />
    </div>
</section>

<section class="section section-auth">
    <div class="container">
        <div class="stats-grid">
            <div class="profile-card"><strong>@Model.Stats.TotalCustomers</strong><span>Toplam müşteri</span></div>
            <div class="profile-card"><strong>@Model.Stats.NewCustomers7d</strong><span>Yeni müşteri (7 gün)</span></div>
            <div class="profile-card"><strong>@Model.Stats.OpenRequests</strong><span>Açık talepler</span></div>
            <div class="profile-card"><strong>@Model.Stats.InProgressRequests</strong><span>İşlemde</span></div>
            <div class="profile-card"><strong>@Model.Stats.WaitingCustomerRequests</strong><span>Müşteri bekleniyor</span></div>
            <div class="profile-card"><strong>@Model.Stats.ResolvedRequests</strong><span>Çözülmüş</span></div>
            <div class="profile-card"><strong>@Model.Stats.UnreadMessages</strong><span>Okunmamış mesaj</span></div>
        </div>

        <div class="admin-table mt-4">
            <h2 class="h5 px-3 pt-3">Son konuşmalar</h2>
            @if (Model.Conversations.Count == 0)
            {
                <p class="form-note px-3 pb-3">Henüz konuşma yok.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Müşteri</th>
                                <th>E-posta</th>
                                <th>Talep</th>
                                <th>Son mesaj</th>
                                <th>Okunmamış</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in Model.Conversations.Take(12))
                        {
                            <tr>
                                <td><a asp-page="/Admin/Konusma" asp-route-id="@row.Id">@row.CustomerName</a></td>
                                <td>@row.CustomerEmail</td>
                                <td>@(row.Subject ?? "—")</td>
                                <td>@(row.LastMessage ?? "—")</td>
                                <td>
                                    @if (row.UnreadCount > 0)
                                    {
                                        <span class="unread-pill">@row.UnreadCount yeni</span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</section>
