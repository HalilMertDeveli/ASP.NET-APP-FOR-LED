@page
@{
    ViewData["Title"] = "LED Ekran Hizmetleri ve Teknik Destek";
    ViewData["MetaDescription"] = "Colorlight teknik destek, NovaStar teknik destek ve Huidu teknik destek: kart ayarları, mapping, gönderici ayarları, yazılım kurulumu ve uzaktan LED ekran desteği.";
    ViewData["CanonicalPath"] = "/Services";

    var brands = new[]
    {
        new {
            Id = "colorlight",
            Name = "Colorlight",
            BadgeClass = "brand-badge-g",
            Image = "/images/brands/controller-a.webp",
            Alt = "Colorlight teknik destek için temsili kontrol ve elektronik ekipman görseli",
            Title = "Colorlight teknik destek",
            Lead = "Colorlight kontrol sistemlerinde kart ve alıcı ayarlarından görüntü sorunlarına kadar uçtan uca LED ekran teknik destek.",
            SectionClass = "section"
        },
        new {
            Id = "novastar",
            Name = "NovaStar",
            BadgeClass = "brand-badge-b",
            Image = "/images/brands/controller-b.webp",
            Alt = "NovaStar teknik destek için temsili laboratuvar ve kontrol ekipmanı görseli",
            Title = "NovaStar teknik destek",
            Lead = "NovaStar gönderici / alıcı mimarisinde konfigürasyon, mapping, kalibrasyon ve yazılım tarafında hızlı çözüm.",
            SectionClass = "section section-alt"
        },
        new {
            Id = "huidu",
            Name = "Huidu",
            BadgeClass = "brand-badge-p",
            Image = "/images/brands/controller-c.webp",
            Alt = "Huidu teknik destek için temsili sunucu ve ağ ekipmanı görseli",
            Title = "Huidu teknik destek",
            Lead = "Huidu kontrol kartı kurulumu, parametre ayarları ve saha ekiplerine anlaşılır uzaktan yönlendirme.",
            SectionClass = "section"
        }
    };

    var bullets = new[]
    {
        "Kart ve alıcı kart ayarları",
        "Ekran çözünürlüğü ve mapping",
        "Gönderici kart ayarları",
        "Yazılım kurulumu ve yapılandırma",
        "Bağlantı ve görüntü sorunları",
        "Uzaktan teknik destek"
    };
}

<section class="page-hero" aria-labelledby="services-page-title">
    <div class="container" data-reveal>
        <p class="eyebrow">Hizmetler / Teknik Destek</p>
        <h1 id="services-page-title">Marka bazlı LED ekran teknik destek</h1>
        <p class="page-lead">
            Colorlight, NovaStar ve Huidu kontrol sistemlerinde kurulum, konfigürasyon,
            görüntü sorunları ve uzaktan teknik destek.
        </p>
    </div>
</section>

@foreach (var brand in brands)
{
    <section class="@brand.SectionClass" id="@brand.Id" aria-labelledby="@($"{brand.Id}-title")">
        <div class="container brand-block brand-block-media" data-reveal>
            <div class="brand-media">
                <img
                    src="@brand.Image"
                    asp-append-version="true"
                    alt="@brand.Alt"
                    width="900"
                    height="600"
                    loading="eager"
                    decoding="async" />
            </div>
            <div class="brand-copy">
                <div class="brand-badge @brand.BadgeClass">@brand.Name</div>
                <h2 id="@($"{brand.Id}-title")">@brand.Title</h2>
                <p>@brand.Lead</p>
                <ul class="check-list">
                    @foreach (var item in bullets)
                    {
                        <li>@item</li>
                    }
                </ul>
                <a class="btn btn-led" asp-page="/Contact" asp-route-system="@brand.Name">Destek Talep Et</a>
            </div>
        </div>
    </section>
}

<section class="section section-alt" aria-labelledby="faq-title">
    <div class="container">
        <header class="section-head" data-reveal>
            <h2 id="faq-title">Sıkça sorulan sorular</h2>
            <p>LED ekran teknik destek sürecinde en çok merak edilenler.</p>
        </header>

        <div class="accordion faq-accordion" id="faqAccordion" data-reveal>
            <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1" aria-expanded="true" aria-controls="faq1">
                        Uzaktan LED ekran desteği nasıl çalışır?
                    </button>
                </h3>
                <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        Güvenli uzaktan bağlantı ile ekranınıza erişilir; kart ayarları, yazılım ve
                        görüntü sorunları adım adım teşhis edilip çözülür veya saha ekibinize yönlendirilir.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2" aria-expanded="false" aria-controls="faq2">
                        Hangi sistemleri destekliyorsunuz?
                    </button>
                </h3>
                <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        Colorlight, NovaStar ve Huidu kontrol sistemleri öncelikli kapsamdadır.
                        Diğer markalar için “Diğer” seçeneğiyle destek talebi oluşturabilirsiniz.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3" aria-expanded="false" aria-controls="faq3">
                        LED ekran kurulumu için ne gerekir?
                    </button>
                </h3>
                <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        Panel modeli, kontrol sistemi (Colorlight / NovaStar / Huidu), çözünürlük hedefi
                        ve mevcut kablolama bilgisi yeterli başlangıçtır. Formdan bu detayları paylaşmanız yeterlidir.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq4" aria-expanded="false" aria-controls="faq4">
                        Mapping ve kalibrasyon ne kadar sürer?
                    </button>
                </h3>
                <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        Ekran boyutu ve mevcut yapılandırmaya göre değişir. Çoğu standart kurulumda
                        uzaktan oturum içinde mapping ve temel kalibrasyon tamamlanır.
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@{
    ViewData["CtaTitle"] = "Hazır mısınız? Destek talep edin";
    ViewData["CtaText"] = "Formu doldurun; Colorlight, NovaStar veya Huidu sisteminiz için size dönüş yapalım.";
}
<partial name="_CtaBand" />
