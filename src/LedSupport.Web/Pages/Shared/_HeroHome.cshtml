@*
  Hero — LED video wall arka plan + overlay
*@
<section class="hero hero-visual" aria-labelledby="hero-title">
    <div class="hero-media-photo" aria-hidden="true">
        <img
            src="~/images/led/hero-led-wall.webp"
            alt=""
            width="1600"
            height="900"
            decoding="async"
            fetchpriority="high" />
        <div class="hero-overlay"></div>
        <div class="hero-fx hero-fx-scan"></div>
        <div class="hero-fx hero-fx-glow"></div>
    </div>

    <div class="container hero-content">
        <p class="eyebrow" data-reveal>LED ekran teknik destek · Colorlight · NovaStar · Huidu</p>
        <h1 id="hero-title" data-reveal>LED Ekran Teknik Destek Hizmeti</h1>
        <p class="hero-lead" data-reveal>
            Colorlight, NovaStar ve Huidu sistemleri için kurulum, yapılandırma,
            arıza çözümü ve uzaktan destek.
        </p>
        <div class="hero-actions" data-reveal>
            <a class="btn btn-led" asp-page="/Contact">Teknik Destek Al</a>
            <a class="btn btn-ghost" asp-page="/Services">Hizmetleri İncele</a>
        </div>
    </div>
</section>
