rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Destek talepleri yalnızca Admin SDK / Cloud Functions ile yazılır.
    // İstemciler okuyamaz, yazamaz, güncelleyemez, silemez.
    match /supportRequests/{requestId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
